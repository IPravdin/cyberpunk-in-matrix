{
  "name": "cyberpunk-in-matrix",
  "version": "1.0.0",
  "private": true,
  "description": "Cyberpunk in The Matrix \u2014 Next.js and Tailwind",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:export": "node scripts/check-export.mjs",
    "test:export": "TEST_TARGET=export playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test",
    "preview": "SITE_DIR=out node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
